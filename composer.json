{
  "name": "logtrace/logtrace-php",
  "description": "PHP client for the Logtrace API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Logtrace\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Logtrace\\Tests\\": "tests/"
    }
  }
}
